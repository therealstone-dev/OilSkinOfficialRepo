# Credenciales Aiven MySQL
MYSQL_HOST=your-aiven-host.aivencloud.com
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your_password
MYSQL_DB=defaultdb
MYSQL_PORT=3306
MYSQL_SSL_CA=/ruta/a/tu/certificado/ca.pem

# Configuración de Correo Electrónico
# Opción 1: Brevo API (Recomendado para Producción sin dominio propio - 300 correos/día a cualquier destinatario)
# Obtén tu API Key gratuita en https://brevo.com (ex-Sendinblue)
BREVO_API_KEY=xkeysib-tu_api_key_de_brevo
MAIL_DEFAULT_SENDER=OilSkin <tu_correo_registrado_en_brevo@gmail.com>

# Opción 2: Resend HTTP API (Recomendado si tienes un dominio propio verificado en resend.com/domains)
# Obtén tu API Key gratuita en https://resend.com
# RESEND_API_KEY=re_tu_api_key_de_resend
# MAIL_DEFAULT_SENDER=OilSkin <soporte@tudominio.com>

# Opción 3: Configuración SMTP tradicional (Para desarrollo local)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USE_SSL=False
# MAIL_USERNAME=tu_correo@gmail.com
# MAIL_PASSWORD=tu_contraseña_de_aplicacion

# Configuración de Servicio de Geolocalización
# Proveedor por defecto: nominatim (OpenStreetMap, gratuito)
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=
GEOCODING_USER_AGENT=OilSkin-ECommerce/1.0 (soporte@oilskin.com)

# Configuración de Google OAuth 2.0 (Inicio de sesión con Google)
# Obtenidos desde Google Cloud Console (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=tu_id_de_cliente.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_secreto_de_cliente
