# Credenciales Aiven MySQL
MYSQL_HOST=your-aiven-host.aivencloud.com
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your_password
MYSQL_DB=defaultdb
MYSQL_PORT=3306
MYSQL_SSL_CA=/ruta/a/tu/certificado/ca.pem

# Configuración de Correo SMTP (Ejemplo Gmail o similar)
# Para Gmail, genera una "Contraseña de aplicación" en: https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion
MAIL_DEFAULT_SENDER=OilSkin <tu_correo@gmail.com>