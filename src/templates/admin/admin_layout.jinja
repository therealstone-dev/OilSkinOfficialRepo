<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Panel de Administración - OilSkin{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              gold: '#CEB06E',
              'gold-light': '#dfc98e',
              'gold-dark': '#a8903b',
              'oil-dark': '#0c0c0c',
              'oil-card': '#141414',
              'oil-border': '#222222',
            }
          }
        }
      }
    </script>
    <link href="https://cdn.jsdelivr.net/npm/flowbite@3.1.2/dist/flowbite.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <style>
        :root {
            --gold: #CEB06E;
            --gold-light: #dfc98e;
            --gold-dark: #a8903b;
            --dark-bg: #0c0c0c;
            --dark-card: #141414;
            --dark-card-hover: #1a1a1a;
            --dark-border: #222222;
            --dark-border-gold: rgba(206, 176, 110, 0.15);
            --text-primary: #f0ece4;
            --text-secondary: #9a9590;
            --text-muted: #5c5650;
        }
        * { font-family: 'Inter', sans-serif; }
        body {
            background-color: var(--dark-bg);
            color: var(--text-primary);
            min-height: 100vh;
        }

        /* ---- Sidebar ---- */
        .admin-sidebar {
            background: var(--dark-card);
            border-right: 1px solid var(--dark-border);
            width: 260px;
            min-height: 100vh;
            position: fixed;
            top: 0; left: 0;
            z-index: 40;
            display: flex;
            flex-direction: column;
            transition: transform 0.3s ease;
        }
        .admin-sidebar .brand-block {
            padding: 28px 24px;
            border-bottom: 1px solid var(--dark-border);
        }
        .admin-sidebar .brand-block .brand-name {
            font-weight: 900;
            font-size: 1.3rem;
            letter-spacing: 3px;
            color: var(--text-primary);
        }
        .admin-sidebar .brand-block .brand-sub {
            font-size: 0.65rem;
            color: var(--gold);
            letter-spacing: 4px;
            text-transform: uppercase;
            font-weight: 600;
        }
        .admin-sidebar .nav-section-title {
            font-size: 0.6rem;
            text-transform: uppercase;
            letter-spacing: 2.5px;
            color: var(--text-muted);
            font-weight: 700;
            padding: 20px 24px 8px 24px;
        }
        .admin-sidebar .nav-link-admin {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 24px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
            margin: 2px 0;
        }
        .admin-sidebar .nav-link-admin:hover {
            color: var(--text-primary);
            background: rgba(206, 176, 110, 0.06);
            border-left-color: rgba(206, 176, 110, 0.3);
        }
        .admin-sidebar .nav-link-admin.active {
            color: var(--gold);
            background: rgba(206, 176, 110, 0.08);
            border-left-color: var(--gold);
            font-weight: 700;
        }
        .admin-sidebar .nav-link-admin i {
            width: 18px;
            text-align: center;
            font-size: 0.9rem;
        }
        .admin-sidebar .user-block {
            padding: 20px 24px;
            border-top: 1px solid var(--dark-border);
            margin-top: auto;
        }

        /* ---- Main ---- */
        .admin-main {
            margin-left: 260px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .admin-topbar {
            background: var(--dark-card);
            border-bottom: 1px solid var(--dark-border);
            padding: 16px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 30;
        }
        .admin-topbar h1 {
            font-size: 1.15rem;
            font-weight: 800;
            letter-spacing: 0.5px;
            margin: 0;
        }
        .admin-content {
            padding: 28px 32px;
            flex: 1;
        }

        /* ---- Cards ---- */
        .admin-card {
            background: var(--dark-card);
            border: 1px solid var(--dark-border);
            border-radius: 14px;
            transition: border-color 0.25s ease, box-shadow 0.25s ease;
        }
        .admin-card:hover {
            border-color: var(--dark-border-gold);
            box-shadow: 0 0 30px rgba(206, 176, 110, 0.04);
        }
        .admin-card-header {
            padding: 18px 22px;
            border-bottom: 1px solid var(--dark-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* ---- KPI Cards ---- */
        .kpi-card {
            background: var(--dark-card);
            border: 1px solid var(--dark-border);
            border-radius: 14px;
            padding: 22px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        .kpi-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--gold), var(--gold-dark));
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .kpi-card:hover::before { opacity: 1; }
        .kpi-card:hover {
            border-color: var(--dark-border-gold);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.3);
        }
        .kpi-label {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text-muted);
            font-weight: 700;
        }
        .kpi-value {
            font-size: 1.65rem;
            font-weight: 900;
            color: var(--text-primary);
            margin-top: 6px;
        }
        .kpi-sub {
            font-size: 0.72rem;
            color: var(--text-secondary);
            margin-top: 4px;
        }
        .kpi-icon {
            width: 42px; height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        /* ---- Tables ---- */
        .admin-table { width: 100%; border-collapse: collapse; }
        .admin-table thead th {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text-muted);
            font-weight: 700;
            padding: 14px 18px;
            border-bottom: 1px solid var(--dark-border);
            background: rgba(0,0,0,0.2);
        }
        .admin-table tbody td {
            padding: 14px 18px;
            font-size: 0.85rem;
            border-bottom: 1px solid rgba(255,255,255,0.03);
            color: var(--text-secondary);
            vertical-align: middle;
        }
        .admin-table tbody tr:hover {
            background: rgba(206, 176, 110, 0.03);
        }
        .admin-table tbody tr:last-child td { border-bottom: none; }

        /* ---- Buttons ---- */
        .btn-gold {
            background: var(--gold);
            color: #0c0c0c;
            font-weight: 800;
            font-size: 0.78rem;
            padding: 8px 18px;
            border-radius: 10px;
            border: none;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-gold:hover {
            background: var(--gold-light);
            color: #0c0c0c;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(206, 176, 110, 0.25);
        }
        .btn-dark-subtle {
            background: rgba(255,255,255,0.05);
            color: var(--text-secondary);
            font-weight: 600;
            font-size: 0.75rem;
            padding: 7px 14px;
            border-radius: 8px;
            border: 1px solid var(--dark-border);
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .btn-dark-subtle:hover {
            background: rgba(255,255,255,0.08);
            color: var(--text-primary);
            border-color: rgba(255,255,255,0.12);
        }
        .btn-danger-subtle {
            background: rgba(239, 68, 68, 0.08);
            color: #ef4444;
            font-weight: 600;
            font-size: 0.75rem;
            padding: 7px 14px;
            border-radius: 8px;
            border: 1px solid rgba(239, 68, 68, 0.15);
            transition: all 0.2s ease;
        }
        .btn-danger-subtle:hover {
            background: rgba(239, 68, 68, 0.15);
        }

        /* ---- Form Fields ---- */
        .admin-input {
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--dark-border);
            color: var(--text-primary);
            border-radius: 10px;
            padding: 9px 14px;
            font-size: 0.82rem;
            transition: all 0.2s ease;
            width: 100%;
        }
        .admin-input:focus {
            outline: none;
            border-color: var(--gold);
            box-shadow: 0 0 0 3px rgba(206, 176, 110, 0.12);
            background: rgba(255,255,255,0.06);
        }
        .admin-select {
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--dark-border);
            color: var(--text-primary);
            border-radius: 10px;
            padding: 9px 14px;
            font-size: 0.82rem;
            width: 100%;
        }
        .admin-select:focus {
            outline: none;
            border-color: var(--gold);
            box-shadow: 0 0 0 3px rgba(206, 176, 110, 0.12);
        }
        .admin-label {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--text-secondary);
            margin-bottom: 5px;
            display: block;
        }

        /* ---- Badges ---- */
        .badge-gold {
            background: rgba(206, 176, 110, 0.12);
            color: var(--gold);
            font-size: 0.7rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 6px;
            border: 1px solid rgba(206, 176, 110, 0.2);
        }
        .badge-dark {
            background: rgba(255,255,255,0.06);
            color: var(--text-secondary);
            font-size: 0.7rem;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 6px;
            border: 1px solid var(--dark-border);
        }
        .badge-danger {
            background: rgba(239, 68, 68, 0.1);
            color: #f87171;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 6px;
            border: 1px solid rgba(239, 68, 68, 0.2);
        }
        .badge-success {
            background: rgba(16, 185, 129, 0.1);
            color: #34d399;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 6px;
            border: 1px solid rgba(16, 185, 129, 0.2);
        }

        /* ---- Modal ---- */
        .admin-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.75);
            backdrop-filter: blur(6px);
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .admin-modal {
            background: var(--dark-card);
            border: 1px solid var(--dark-border-gold);
            border-radius: 18px;
            max-width: 500px;
            width: 100%;
            padding: 28px;
            box-shadow: 0 24px 64px rgba(0,0,0,0.6);
        }
        .admin-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--dark-border);
            margin-bottom: 20px;
        }
        .admin-modal-header h3 {
            font-weight: 800;
            font-size: 1.05rem;
            color: var(--text-primary);
            margin: 0;
        }

        /* ---- Status indicator ---- */
        .status-dot {
            width: 7px; height: 7px;
            border-radius: 50%;
            display: inline-block;
            animation: pulse-dot 2s infinite;
        }
        @keyframes pulse-dot {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }

        /* ---- Responsive ---- */
        @media (max-width: 768px) {
            .admin-sidebar { transform: translateX(-100%); }
            .admin-sidebar.show { transform: translateX(0); }
            .admin-main { margin-left: 0; }
            .admin-content { padding: 20px 16px; }
            .admin-topbar { padding: 14px 16px; }
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <aside class="admin-sidebar" id="adminSidebar">
        <div class="brand-block">
            <div class="d-flex align-items-center gap-3">
                <img src="{{ url_for('static', filename='img/logo.webp') }}" alt="OilSkin" style="width: 38px; height: 38px; border-radius: 10px; object-fit: cover; border: 2px solid var(--gold);">
                <div>
                    <div class="brand-name">OILSKIN</div>
                    <div class="brand-sub">Admin Panel</div>
                </div>
            </div>
        </div>

        <div class="nav-section-title">Navegación</div>

        <a href="{{ url_for('admin_blueprint.dashboard') }}" class="nav-link-admin {% if active_page == 'metricas' %}active{% endif %}">
            <i class="fa-solid fa-chart-line"></i> Métricas
        </a>
        <a href="{{ url_for('admin_blueprint.usuarios') }}" class="nav-link-admin {% if active_page == 'usuarios' %}active{% endif %}">
            <i class="fa-solid fa-users"></i> Usuarios
        </a>
        <a href="{{ url_for('admin_blueprint.inventario') }}" class="nav-link-admin {% if active_page == 'inventario' %}active{% endif %}">
            <i class="fa-solid fa-boxes-stacked"></i> Inventario
        </a>
        <a href="{{ url_for('admin_blueprint.ventas') }}" class="nav-link-admin {% if active_page == 'ventas' %}active{% endif %}">
            <i class="fa-solid fa-receipt"></i> Ventas
        </a>

        <div class="nav-section-title" style="margin-top:16px;">Accesos Rápidos</div>

        <a href="{{ url_for('main_blueprint.index') }}" class="nav-link-admin">
            <i class="fa-solid fa-store"></i> Ir a la Tienda
        </a>

        <div class="user-block">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div style="width:36px; height:36px; border-radius:10px; background:rgba(206,176,110,0.1); border:1px solid rgba(206,176,110,0.2); display:flex; align-items:center; justify-content:center; color:var(--gold); font-size:0.85rem;">
                    <i class="fa-solid fa-user-shield"></i>
                </div>
                <div>
                    <div style="font-size:0.82rem; font-weight:700; color:var(--text-primary);">{{ session.get('user_name', 'Admin') }}</div>
                    <div style="font-size:0.65rem; color:var(--text-muted);">Administrador</div>
                </div>
            </div>
            <a href="{{ url_for('auth_blueprint.logout') }}" class="btn-dark-subtle w-100 justify-content-center" style="font-size:0.72rem;">
                <i class="fa-solid fa-right-from-bracket"></i> Cerrar Sesión
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="admin-main">
        <!-- Top Bar -->
        <div class="admin-topbar">
            <div class="d-flex align-items-center gap-3">
                <button class="d-md-none btn btn-sm text-white border-0" id="sidebarToggle">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div>
                    <h1>{% block header_title %}Panel{% endblock %}</h1>
                    <div style="font-size:0.72rem; color:var(--text-muted); margin-top:2px;">{% block header_subtitle %}{% endblock %}</div>
                </div>
            </div>
            <div class="d-none d-sm-flex align-items-center gap-2" style="font-size:0.72rem; font-weight:600; color:var(--text-muted);">
                <span class="status-dot" style="background:#34d399;"></span> Sistema en línea
            </div>
        </div>

        <!-- Flash Messages -->
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                <div style="padding: 20px 32px 0 32px;">
                    {% for category, message in messages %}
                        <div class="d-flex align-items-center justify-content-between mb-2" style="padding:12px 18px; border-radius:10px; font-size:0.8rem; font-weight:600;
                            {% if category == 'success' %}background:rgba(16,185,129,0.08); color:#34d399; border:1px solid rgba(16,185,129,0.15);
                            {% elif category == 'danger' %}background:rgba(239,68,68,0.08); color:#f87171; border:1px solid rgba(239,68,68,0.15);
                            {% else %}background:rgba(56,189,248,0.08); color:#38bdf8; border:1px solid rgba(56,189,248,0.15);{% endif %}">
                            <span>{{ message }}</span>
                            <button onclick="this.parentElement.remove()" style="border:none; background:none; color:inherit; opacity:0.6; cursor:pointer;"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endwith %}

        <!-- Page Content -->
        <div class="admin-content">
            {% block admin_content %}{% endblock %}
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/flowbite@3.1.2/dist/flowbite.min.js"></script>
    <script>
        const toggle = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('adminSidebar');
        if (toggle && sidebar) {
            toggle.addEventListener('click', () => sidebar.classList.toggle('show'));
        }
    </script>
    {% block admin_scripts %}{% endblock %}
</body>
</html>
