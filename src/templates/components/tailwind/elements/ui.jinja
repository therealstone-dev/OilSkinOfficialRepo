{% macro sidebar(items) %}
<!-- Mobile Toggle Button -->
<button data-drawer-target="default-sidebar" data-drawer-toggle="default-sidebar" aria-controls="default-sidebar" type="button" 
        class="fixed top-4 left-4 z-50 text-neutral-300 bg-neutral-900 shadow-lg border border-neutral-700 font-medium rounded-xl text-sm p-2.5 focus:outline-none inline-flex sm:hidden items-center justify-center hover:text-[#CEB06E] transition-all">
   <span class="sr-only">Abrir menú</span>
   <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
      <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h10"/>
   </svg>
</button>

<!-- Sidebar -->
<aside id="default-sidebar" class="fixed top-0 left-0 z-40 w-64 h-full transition-transform -translate-x-full sm:translate-x-0 bg-neutral-900 border-r border-neutral-800 shadow-2xl flex flex-col" aria-label="Sidebar">
   
   <!-- Brand Block -->
   <div class="p-6 border-b border-neutral-800 flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-black border border-[#CEB06E]/40 flex items-center justify-center text-[#CEB06E] text-xl font-bold shadow-md shrink-0">
         <i class="fa-solid fa-droplet"></i>
      </div>
      <div>
         <span class="font-extrabold text-lg tracking-wider text-white block">OILSKIN</span>
         <span class="text-[10px] text-[#CEB06E] uppercase font-bold tracking-widest block">Panel de Cliente</span>
      </div>
   </div>

   <!-- Navigation Links -->
   <div class="flex-1 px-4 py-6 overflow-y-auto">
      <div class="text-[10px] uppercase font-extrabold tracking-widest text-neutral-500 px-3 mb-3">Navegación</div>
      <ul class="space-y-1.5 font-medium">
        {% for item in items %}
        <li>
            <a href="{{ item.url }}" class="flex items-center px-3 py-2.5 text-neutral-300 rounded-xl hover:bg-[#CEB06E]/15 hover:text-[#CEB06E] border border-transparent hover:border-[#CEB06E]/30 transition-all group text-sm font-semibold">
               <i class="{{ item.icon }} text-base w-6 text-center text-neutral-400 group-hover:text-[#CEB06E] transition-colors"></i>
               <span class="ms-3">{{ item.name }}</span>
            </a>
         </li>
        {% endfor %}
      </ul>

      <div class="text-[10px] uppercase font-extrabold tracking-widest text-neutral-500 px-3 mt-8 mb-3">Accesos Rápidos</div>
      <ul class="space-y-1.5 font-medium">
         <li>
            <a href="{{ url_for('main_blueprint.index') }}" class="flex items-center px-3 py-2.5 text-neutral-300 rounded-xl hover:bg-[#CEB06E]/15 hover:text-[#CEB06E] border border-transparent hover:border-[#CEB06E]/30 transition-all group text-sm font-semibold">
               <i class="fa-solid fa-store text-base w-6 text-center text-neutral-400 group-hover:text-[#CEB06E]"></i>
               <span class="ms-3">Ir a la Tienda</span>
            </a>
         </li>
         <li>
            <a href="{{ url_for('main_blueprint.carrito') }}" class="flex items-center px-3 py-2.5 text-neutral-300 rounded-xl hover:bg-[#CEB06E]/15 hover:text-[#CEB06E] border border-transparent hover:border-[#CEB06E]/30 transition-all group text-sm font-semibold">
               <i class="fa-solid fa-cart-shopping text-base w-6 text-center text-neutral-400 group-hover:text-[#CEB06E]"></i>
               <span class="ms-3">Carrito Público</span>
            </a>
         </li>
      </ul>
   </div>

   <!-- User Profile & Logout Bottom -->
   <div class="p-4 border-t border-neutral-800 bg-neutral-950/60">
      <div class="flex items-center gap-3 mb-3">
         <div class="w-9 h-9 rounded-lg bg-[#CEB06E] text-neutral-950 flex items-center justify-center font-bold text-sm shrink-0">
            {{ (user.nombre[0] if user and user.nombre else session.get('user_name', 'U')[0]) | upper }}
         </div>
         <div class="min-w-0 flex-1">
            <div class="text-xs font-bold text-white truncate">{{ user.nombre if user else session.get('user_name', 'Usuario') }}</div>
            <div class="text-[10px] text-neutral-400 truncate">{{ user.email if user else session.get('user_email', '') }}</div>
         </div>
      </div>
      <a href="{{ url_for('auth_blueprint.logout') }}" class="w-full py-2 px-3 bg-red-950/40 hover:bg-red-950/80 text-red-400 border border-red-800/60 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2">
         <i class="fa-solid fa-right-from-bracket"></i> Cerrar Sesión
      </a>
   </div>
</aside>
{% endmacro %}