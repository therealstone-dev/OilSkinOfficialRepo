{% extends 'components/tailwind/layout.jinja' %}
{% block title %}Finalizar Compra - Checkout Seguro OilSkin{% endblock %}

{% block content %}
<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<main class="min-h-screen py-12" style="background: linear-gradient(rgba(0,0,0,0.85), rgba(0,0,0,0.85)), url('{{ url_for('static', filename='img/fondo_2.webp') }}') center/cover no-repeat fixed;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 mb-8 border-b border-neutral-800 gap-4">
            <div>
                <span class="text-gold text-xs font-bold uppercase tracking-widest flex items-center gap-1.5 mb-1">
                    <i class="fa-solid fa-lock"></i> Checkout Cifrado y Seguro
                </span>
                <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
                    Finalizar Compra y Despacho
                </h1>
            </div>
            <a href="{{ url_for('main_blueprint.carrito') }}" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-neutral-700 bg-neutral-900/80 text-neutral-300 hover:text-gold hover:border-gold transition text-sm font-semibold self-start md:self-auto">
                <i class="fa-solid fa-arrow-left"></i> Volver al Carrito
            </a>
        </div>

        <!-- Flash Messages (Flowbite Alerts) -->
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                <div class="mb-6 space-y-3">
                    {% for category, message in messages %}
                        <div class="flex items-center p-4 text-sm rounded-2xl border {% if category == 'success' %}bg-emerald-950/40 text-emerald-300 border-emerald-500/40{% elif category == 'danger' or category == 'error' %}bg-red-950/40 text-red-300 border-red-500/40{% else %}bg-amber-950/40 text-amber-300 border-amber-500/40{% endif %} shadow-lg backdrop-blur-sm" role="alert">
                            <i class="fa-solid {% if category == 'success' %}fa-circle-check text-emerald-400{% elif category == 'danger' or category == 'error' %}fa-circle-exclamation text-red-400{% else %}fa-circle-info text-amber-400{% endif %} me-3 text-lg"></i>
                            <div class="flex-1 font-medium">{{ message }}</div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endwith %}

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Formulario de Datos de Entrega y Pago (Left 7 cols) -->
            <div class="lg:col-span-7">
                <form method="POST" id="checkoutForm" class="space-y-6">
                    <!-- Hidden inputs for coordinates and origin -->
                    <input type="hidden" id="lat_entrega" name="lat_entrega" value="4.6533">
                    <input type="hidden" id="lng_entrega" name="lng_entrega" value="-74.0836">
                    <input type="hidden" id="origen_despacho" name="origen_despacho" value="Centro de Distribución OilSkin - Bogotá D.C.">
                    <input type="hidden" id="lat_origen" name="lat_origen" value="4.6533">
                    <input type="hidden" id="lng_origen" name="lng_origen" value="-74.0836">

                    <!-- Bloque 1: Información de Contacto y Entrega -->
                    <div class="bg-neutral-900/90 border border-neutral-800 rounded-3xl p-6 md:p-8 shadow-2xl space-y-6">
                        
                        <div class="flex items-center gap-2 pb-4 border-b border-neutral-800">
                            <i class="fa-solid fa-map-location-dot text-gold text-lg"></i>
                            <h2 class="text-lg font-bold text-white">1. Datos de Entrega y Localización</h2>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="sm:col-span-2">
                                <label class="block text-xs font-bold text-neutral-300 uppercase tracking-wider mb-2">Nombre Completo de quien recibe *</label>
                                <input type="text" class="w-full bg-black border border-neutral-700 focus:border-gold focus:ring-1 focus:ring-gold text-white rounded-xl px-4 py-3 text-sm" name="nombre" 
                                       value="{{ user.nombre if user else '' }}" placeholder="Ej. Carlos Mendoza" required>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-neutral-300 uppercase tracking-wider mb-2">Ciudad de Entrega *</label>
                                <input type="text" class="w-full bg-black border border-neutral-700 focus:border-gold focus:ring-1 focus:ring-gold text-white rounded-xl px-4 py-3 text-sm" id="ciudad" name="ciudad" 
                                       value="Bogotá" placeholder="Ej. Bogotá, Medellín, Cali" required onchange="verificarDireccionEnMapa()">
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-neutral-300 uppercase tracking-wider mb-2">Teléfono o Celular *</label>
                                <input type="tel" class="w-full bg-black border border-neutral-700 focus:border-gold focus:ring-1 focus:ring-gold text-white rounded-xl px-4 py-3 text-sm" name="telefono_contacto" 
                                       value="{{ user.celular if user else '' }}" placeholder="Ej. 3101234567" required>
                            </div>

                            <div class="sm:col-span-2">
                                <label class="block text-xs font-bold text-neutral-300 uppercase tracking-wider mb-2">Dirección de Entrega Exacta *</label>
                                <div class="flex gap-2">
                                    <input type="text" class="flex-1 bg-black border border-neutral-700 focus:border-gold focus:ring-1 focus:ring-gold text-white rounded-xl px-4 py-3 text-sm" id="direccion_entrega" name="direccion_entrega" 
                                           value="{{ user.direccion if user else '' }}" placeholder="Ej. Calle 26 # 68-50, Apto 402" required onchange="verificarDireccionEnMapa()">
                                    <button type="button" class="px-5 py-3 bg-gold hover:bg-gold-light text-neutral-950 font-bold rounded-xl text-sm transition shrink-0 flex items-center gap-2 shadow-md shadow-gold/20" onclick="verificarDireccionEnMapa()">
                                        <i class="fa-solid fa-magnifying-glass-location"></i> <span>Verificar</span>
                                    </button>
                                </div>
                                <span class="text-[11px] text-neutral-400 mt-1.5 block">
                                    El sistema posicionará de forma satelital tu punto de entrega para el transporte oficial.
                                </span>
                            </div>
                        </div>

                        <!-- Interactive Verification Map Container -->
                        <div class="pt-4 border-t border-neutral-800 space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-bold text-white flex items-center gap-2">
                                    <i class="fa-solid fa-satellite text-gold"></i> Mapa Satelital de Cobertura
                                </span>
                                <span id="map-status" class="px-3 py-1 rounded-full text-xs font-semibold bg-neutral-800 text-neutral-300">
                                    Esperando dirección...
                                </span>
                            </div>

                            <div id="checkout-map" class="rounded-2xl border border-neutral-700 shadow-inner h-64 w-full relative overflow-hidden bg-black z-10">
                            </div>

                            <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs text-neutral-400 gap-1">
                                <span><i class="fa-solid fa-hand-pointer text-gold me-1"></i> Puedes arrastrar el marcador para afinar la ubicación.</span>
                                <span id="coord-badge" class="text-gold font-mono"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Bloque 2: Método de Pago -->
                    <div class="bg-neutral-900/90 border border-neutral-800 rounded-3xl p-6 md:p-8 shadow-2xl space-y-6">
                        
                        <div class="flex items-center gap-2 pb-4 border-b border-neutral-800">
                            <i class="fa-solid fa-credit-card text-gold text-lg"></i>
                            <h2 class="text-lg font-bold text-white">2. Selecciona tu Método de Pago</h2>
                        </div>

                        <div class="space-y-3">
                            <label class="p-4 rounded-2xl border border-gold bg-gold/10 flex items-center justify-between cursor-pointer payment-option transition hover:border-gold">
                                <div class="flex items-center gap-3">
                                    <input type="radio" name="metodo_pago" value="efectivo" checked class="w-4 h-4 text-gold bg-black border-neutral-700 focus:ring-gold focus:ring-2" onchange="seleccionarPago(this)">
                                    <div>
                                        <div class="text-white text-sm font-bold">Pago en Efectivo / Contra Entrega</div>
                                        <div class="text-neutral-400 text-xs mt-0.5">Cancela al momento de recibir tu paquete en la puerta</div>
                                    </div>
                                </div>
                                <i class="fa-solid fa-hand-holding-dollar text-2xl text-gold"></i>
                            </label>

                            <label class="p-4 rounded-2xl border border-neutral-800 bg-neutral-950/60 flex items-center justify-between cursor-pointer payment-option transition hover:border-neutral-700">
                                <div class="flex items-center gap-3">
                                    <input type="radio" name="metodo_pago" value="transferencia" class="w-4 h-4 text-gold bg-black border-neutral-700 focus:ring-gold focus:ring-2" onchange="seleccionarPago(this)">
                                    <div>
                                        <div class="text-white text-sm font-bold">Transferencia Bancaria / PSE / Nequi</div>
                                        <div class="text-neutral-400 text-xs mt-0.5">Pago digital instantáneo con comprobante electrónico</div>
                                    </div>
                                </div>
                                <i class="fa-solid fa-building-columns text-2xl text-neutral-400"></i>
                            </label>

                            <label class="p-4 rounded-2xl border border-neutral-800 bg-neutral-950/60 flex items-center justify-between cursor-pointer payment-option transition hover:border-neutral-700">
                                <div class="flex items-center gap-3">
                                    <input type="radio" name="metodo_pago" value="tarjeta" class="w-4 h-4 text-gold bg-black border-neutral-700 focus:ring-gold focus:ring-2" onchange="seleccionarPago(this)">
                                    <div>
                                        <div class="text-white text-sm font-bold">Tarjeta de Crédito / Débito (Visa, Mastercard)</div>
                                        <div class="text-neutral-400 text-xs mt-0.5">Pasarela segura cifrada con token 3D Secure</div>
                                    </div>
                                </div>
                                <i class="fa-brands fa-cc-visa text-2xl text-neutral-400"></i>
                            </label>
                        </div>
                    </div>

                    <!-- Botón de Envío -->
                    <button type="submit" class="w-full py-4 px-6 rounded-xl font-extrabold text-neutral-950 bg-gold hover:bg-gold-light shadow-2xl shadow-gold/30 transition transform hover:-translate-y-0.5 flex items-center justify-center gap-2 text-base">
                        <i class="fa-solid fa-shield-check"></i>
                        <span>Confirmar y Realizar Pedido</span>
                    </button>
                </form>
            </div>

            <!-- Columna Resumen de Compra (Right 5 cols) -->
            <div class="lg:col-span-5">
                <div class="bg-neutral-900 border border-gold/35 rounded-3xl p-6 shadow-2xl sticky top-24 space-y-6">
                    
                    <div class="flex items-center justify-between pb-4 border-b border-neutral-800">
                        <h3 class="text-base font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-basket-shopping text-gold"></i> Resumen de Compra
                        </h3>
                        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-neutral-800 text-gold border border-neutral-700">
                            {{ total_items }} artículos
                        </span>
                    </div>

                    <!-- Items List -->
                    <div class="space-y-3 max-h-72 overflow-y-auto pr-1">
                        {% for item in carrito %}
                            <div class="flex items-center justify-between gap-3 p-3 rounded-2xl bg-neutral-950/60 border border-neutral-800">
                                <div class="w-11 h-11 rounded-xl bg-gold/10 border border-gold/20 flex items-center justify-center text-gold shrink-0">
                                    <i class="fa-solid fa-spray-can-sparkles text-sm"></i>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="font-bold text-white text-xs truncate">{{ item.nombre_producto }}</div>
                                    <div class="text-neutral-400 text-[11px]">{{ item.cantidad }} x ${{ "{:,.2f}".format(item.precio_unitario) }}</div>
                                </div>
                                <div class="font-bold text-gold text-xs">
                                    ${{ "{:,.2f}".format(item.subtotal) }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <!-- Subtotales y Total -->
                    <div class="border-t border-neutral-800 pt-4 space-y-2 text-xs">
                        <div class="flex justify-between text-neutral-300">
                            <span>Subtotal productos:</span>
                            <span class="font-bold text-white">${{ "{:,.2f}".format(total_precio) }}</span>
                        </div>
                        <div class="flex justify-between text-neutral-300">
                            <span>Envío a domicilio:</span>
                            <span class="text-emerald-400 font-bold flex items-center gap-1"><i class="fa-solid fa-check"></i> ¡Gratis!</span>
                        </div>
                        <div class="flex justify-between text-neutral-300">
                            <span>Empaque ecológico:</span>
                            <span class="text-gold font-semibold">Incluido</span>
                        </div>

                        <div class="border-t border-neutral-800 pt-4 mt-3 flex justify-between items-baseline">
                            <div>
                                <span class="text-xs uppercase font-extrabold text-neutral-400 block tracking-wider">Total a Pagar:</span>
                                <span class="text-[10px] text-neutral-400">COP • IVA incluido</span>
                            </div>
                            <span class="text-2xl font-black text-gold">
                                ${{ "{:,.2f}".format(total_precio) }}
                            </span>
                        </div>
                    </div>

                    <!-- Garantías -->
                    <div class="pt-4 border-t border-neutral-800 space-y-2 text-[11px] text-neutral-400">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-shield-check text-gold"></i> Garantía de 30 días con satisfacción 100%
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-truck-fast text-gold"></i> Despacho express con trazabilidad satelital en vivo
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</main>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
let map = null;
let marker = null;
let debounceTimer = null;

// Custom Golden Leaflet Icon
const goldIcon = L.icon({
    iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-gold.png',
    shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
    iconSize: [25, 41],
    iconAnchor: [12, 41],
    popupAnchor: [1, -34],
    shadowSize: [41, 41]
});

function normalizarDireccionColombia(dir) {
    if (!dir) return '';
    let d = dir.trim().toLowerCase();

    // 1. Normalizar prefijos viales colombianos
    d = d.replace(/\b(cll|cl|c)\.?\b/g, 'calle');
    d = d.replace(/\b(cra|cr|kra|kr|k)\.?\b/g, 'carrera');
    d = d.replace(/\b(avda|av|ak)\.?\b/g, 'avenida');
    d = d.replace(/\b(diag|dg)\.?\b/g, 'diagonal');
    d = d.replace(/\b(trans|tv)\.?\b/g, 'transversal');
    d = d.replace(/\bac\b/g, 'avenida calle');
    d = d.replace(/\bautonorte\b/g, 'autopista norte');
    d = d.replace(/\bautosur\b/g, 'autopista sur');

    // 2. Normalizar cuadrantes y sufijos cardinales
    d = d.replace(/(\d+)\s*s\b/g, '$1 sur');
    d = d.replace(/(\d+)\s*e\b/g, '$1 este');
    d = d.replace(/(\d+)\s*n\b/g, '$1 norte');
    d = d.replace(/(\d+)\s*o\b/g, '$1 oeste');
    d = d.replace(/(\d+)\s*w\b/g, '$1 oeste');

    // 3. Normalizar símbolos #, No., No, Nro, N°
    d = d.replace(/(?:no\.?|nro\.?|num\.?|n°)\s*/g, '#');
    d = d.replace(/\s*#\s*/g, ' # ');
    d = d.replace(/\s+/g, ' ').trim();

    return d;
}

function generarConsultasGeocodificacion(dirNorm, ciudad) {
    const city = ciudad.trim() || 'Bogotá';
    const queries = [];

    queries.push({ q: `${dirNorm}, ${city}, Colombia`, level: 'exact' });

    const matchNum = dirNorm.match(/^(.*?)\s*#\s*(\d+)(?:-\d+)?(.*)$/);
    if (matchNum) {
        const viaPrincipal = matchNum[1].trim();
        const numCruce = matchNum[2].trim();
        queries.push({ q: `${viaPrincipal} #${numCruce}, ${city}, Colombia`, level: 'block' });
        queries.push({ q: `${viaPrincipal} ${numCruce}, ${city}, Colombia`, level: 'block' });
        queries.push({ q: `${viaPrincipal}, ${city}, Colombia`, level: 'street' });
    } else {
        queries.push({ q: `${dirNorm}, ${city}, Colombia`, level: 'street' });
    }

    queries.push({ q: `${city}, Colombia`, level: 'city' });

    return queries;
}

function initMap() {
    const defaultLat = 4.6533;
    const defaultLng = -74.0836;

    map = L.map('checkout-map').setView([defaultLat, defaultLng], 12);

    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; CARTO | OpenStreetMap',
        maxZoom: 19
    }).addTo(map);

    marker = L.marker([defaultLat, defaultLng], {
        icon: goldIcon,
        draggable: true
    }).addTo(map);

    marker.bindPopup("<b style='color:#000;'>📍 Punto de Entrega</b><br><span style='color:#555; font-size:11px;'>Mueve este pin para ajustar tu ubicación exacta</span>").openPopup();

    marker.on('dragend', function (e) {
        const pos = marker.getLatLng();
        actualizarCoordenadas(pos.lat, pos.lng, "Ubicación fijada manualmente");
        obtenerDireccionInversa(pos.lat, pos.lng);
    });

    map.on('click', function(e) {
        marker.setLatLng(e.latlng);
        actualizarCoordenadas(e.latlng.lat, e.latlng.lng, "Punto fijado en el mapa");
        obtenerDireccionInversa(e.latlng.lat, e.latlng.lng);
    });

    const initialAddress = document.getElementById('direccion_entrega').value.trim();
    if (initialAddress) {
        verificarDireccionEnMapa();
    }
}

function actualizarCoordenadas(lat, lng, mensajeEstado = null) {
    document.getElementById('lat_entrega').value = lat.toFixed(7);
    document.getElementById('lng_entrega').value = lng.toFixed(7);
    document.getElementById('coord-badge').innerText = `Lat: ${lat.toFixed(4)}, Lng: ${lng.toFixed(4)}`;
    
    const statusBadge = document.getElementById('map-status');
    if (mensajeEstado) {
        statusBadge.className = "px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-sm";
        statusBadge.innerHTML = `<i class="fa-solid fa-circle-check me-1"></i> ${mensajeEstado}`;
    }
}

async function obtenerDireccionInversa(lat, lng) {
    try {
        const resp = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`);
        const data = await resp.json();
        if (data && data.display_name) {
            const shortName = data.name || data.address.road || data.address.neighbourhood || data.address.suburb || data.display_name.split(',')[0];
            marker.bindPopup(`<b style='color:#000;'>📍 Ubicación Seleccionada</b><br><span style='color:#444; font-size:11px;'>${shortName} (${data.address.city || data.address.town || 'Colombia'})</span>`).openPopup();
        }
    } catch (e) {
        console.warn("Reverse geocode silent fallback:", e);
    }
}

async function verificarDireccionEnMapa() {
    const direccionInput = document.getElementById('direccion_entrega').value.trim();
    const ciudadInput = document.getElementById('ciudad').value.trim() || 'Bogotá';
    const statusBadge = document.getElementById('map-status');

    if (!direccionInput) {
        statusBadge.className = "px-3 py-1 rounded-full text-xs font-semibold bg-neutral-800 text-neutral-300";
        statusBadge.innerText = "Ingresa una dirección...";
        return;
    }

    statusBadge.className = "px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/40";
    statusBadge.innerHTML = `<i class="fa-solid fa-spinner fa-spin me-1"></i> Localizando en mapa satelital...`;

    const dirNorm = normalizarDireccionColombia(direccionInput);
    const queries = generarConsultasGeocodificacion(dirNorm, ciudadInput);

    let matchEncontrado = null;

    for (const item of queries) {
        try {
            const url = `https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&countrycodes=co&limit=1&q=${encodeURIComponent(item.q)}`;
            const response = await fetch(url);
            const data = await response.json();

            if (data && data.length > 0) {
                matchEncontrado = {
                    lat: parseFloat(data[0].lat),
                    lon: parseFloat(data[0].lon),
                    displayName: data[0].display_name,
                    level: item.level
                };
                break;
            }
        } catch (err) {
            console.warn("Intento de geocodificación fallido:", item.q, err);
        }
    }

    if (matchEncontrado) {
        const { lat, lon, displayName, level } = matchEncontrado;

        let zoomLevel = 17;
        let badgeMsg = "Dirección verificada con éxito ✓";

        if (level === 'street') {
            zoomLevel = 16;
            badgeMsg = "Vía localizada • Ajusta el pin a tu predio";
        } else if (level === 'city') {
            zoomLevel = 13;
            badgeMsg = "Ciudad localizada • Mueve el pin a tu ubicación";
        }

        map.setView([lat, lon], zoomLevel);
        marker.setLatLng([lat, lon]);
        marker.bindPopup(`<b style='color:#000;'>📍 ${level === 'exact' ? 'Dirección Exacta' : 'Ubicación Localizada'}</b><br><span style='color:#333; font-size:11px;'>${displayName}</span>`).openPopup();

        actualizarCoordenadas(lat, lon, badgeMsg);
    } else {
        statusBadge.className = "px-3 py-1 rounded-full text-xs font-semibold bg-sky-500/20 text-sky-300 border border-sky-500/40";
        statusBadge.innerHTML = `<i class="fa-solid fa-location-crosshairs me-1"></i> Ubicación aproximada - Mueve el pin`;
    }
}

function seleccionarPago(radio) {
    document.querySelectorAll('.payment-option').forEach(el => {
        el.classList.remove('border-gold', 'bg-gold/10');
        el.classList.add('border-neutral-800', 'bg-neutral-950/60');
    });
    const parent = radio.closest('.payment-option');
    if (parent) {
        parent.classList.remove('border-neutral-800', 'bg-neutral-950/60');
        parent.classList.add('border-gold', 'bg-gold/10');
    }
}

document.addEventListener('DOMContentLoaded', initMap);
</script>
{% endblock %}
