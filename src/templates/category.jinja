{% extends 'components/tailwind/layout.jinja' %}

{% block title %}{{ category_name }} - OilSkin Cosmética Natural{% endblock %}

{% block content %}

<main class="min-h-screen w-full py-12 md:py-16"
      style="background: linear-gradient(rgba(0,0,0,0.85), rgba(0,0,0,0.85)), url('{{ url_for('static', filename='img/fondo_2.png') }}') center/cover no-repeat fixed;">

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- HEADER CATEGORÍA -->
        <div class="text-center max-w-3xl mx-auto mb-12 space-y-4">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gold/10 border border-gold/30 text-gold text-xs font-bold uppercase tracking-wider">
                <i class="fa-solid fa-leaf"></i> Colección Botánica
            </span>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
                {{ category_name }}
            </h1>
            <p class="text-neutral-300 text-base md:text-lg font-light leading-relaxed">
                {{ descripcion or 'Línea especializada de cuidado consciente y bienestar profundo formulada con activos de palma.' }}
            </p>

            <div class="flex items-center justify-center gap-2 flex-wrap pt-2">
                {% if productos %}
                <span class="bg-neutral-800 text-gold text-xs font-bold px-3 py-1.5 rounded-full border border-neutral-700">
                    <i class="fa-solid fa-boxes-stacked me-1"></i> {{ productos|length }} {{ 'Producto disponible' if productos|length == 1 else 'Productos disponibles' }}
                </span>
                {% endif %}
                <span class="bg-neutral-800/80 text-neutral-300 text-xs font-semibold px-3 py-1.5 rounded-full border border-neutral-700">
                    <i class="fa-solid fa-certificate text-gold me-1"></i> 100% Orgánico
                </span>
                <span class="bg-neutral-800/80 text-neutral-300 text-xs font-semibold px-3 py-1.5 rounded-full border border-neutral-700">
                    <i class="fa-solid fa-wand-magic-sparkles text-gold me-1"></i> Piel Renovada
                </span>
            </div>
        </div>

        <!-- PRODUCTOS GRID -->
        {% if productos %}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

            {% for p in productos %}
            <div class="bg-neutral-900/90 backdrop-blur-sm border border-neutral-800 hover:border-gold/60 rounded-2xl overflow-hidden shadow-lg transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-gold/10 flex flex-col justify-between group">
                
                <div class="p-6 text-center space-y-4">
                    <div class="relative w-28 h-28 mx-auto">
                        <div class="absolute -inset-1 bg-gold/20 rounded-full blur-sm group-hover:bg-gold/40 transition duration-300"></div>
                        <img src="{{ url_for('static', filename='img/logo.png') }}"
                             class="relative w-28 h-28 rounded-full object-cover border-2 border-gold/50 shadow-md mx-auto"
                             alt="{{ p.nombre_producto }}">
                    </div>

                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-widest text-gold bg-gold/10 px-2.5 py-0.5 rounded-md border border-gold/20">
                            {{ category_name }}
                        </span>
                        <h3 class="text-white text-lg font-bold mt-2 group-hover:text-gold transition-colors">
                            {{ p.nombre_producto }}
                        </h3>
                    </div>

                    <p class="text-neutral-400 text-xs leading-relaxed line-clamp-3">
                        {{ p.descripcion }}
                    </p>
                </div>

                <div class="p-5 border-t border-neutral-800 bg-neutral-950/60 flex items-center justify-between gap-3">
                    <div>
                        <span class="text-[10px] text-neutral-400 block font-medium">Precio</span>
                        <span class="text-xl font-extrabold text-gold">
                            ${{ "%.2f"|format(p.precio) }}
                        </span>
                    </div>

                    <a href="{{ url_for('main_blueprint.get_product', id=p.id_producto) }}"
                       class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold text-neutral-950 bg-gold hover:bg-gold-light rounded-xl transition-all shadow-md shadow-gold/20">
                        <span>Ver Detalle</span>
                        <i class="fa-solid fa-arrow-right text-[10px]"></i>
                    </a>
                </div>

            </div>
            {% endfor %}

        </div>

        {% else %}
        <div class="bg-neutral-900/80 border border-neutral-800 rounded-3xl p-12 text-center max-w-lg mx-auto text-white space-y-4">
            <div class="w-16 h-16 rounded-full bg-neutral-800 flex items-center justify-center mx-auto text-neutral-400 text-2xl">
                <i class="fa-solid fa-box-open"></i>
            </div>
            <h3 class="text-xl font-bold">No hay productos disponibles</h3>
            <p class="text-neutral-400 text-sm">Actualmente estamos renovando el inventario de esta categoría botánica.</p>
            <a href="{{ url_for('main_blueprint.index') }}" class="inline-block px-6 py-2.5 bg-gold text-neutral-950 font-bold rounded-xl text-sm">
                Volver a la tienda
            </a>
        </div>
        {% endif %}

    </div>

</main>

{% endblock %}