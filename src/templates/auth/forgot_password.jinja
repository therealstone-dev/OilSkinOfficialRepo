{% extends 'components/tailwind/layout.jinja' %}

{% block title %}Recuperar Contraseña - OilSkin{% endblock %}

{% block content %}
<main class="min-h-[85vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="w-full max-w-lg space-y-6">
        
        <!-- Tarjeta Principal -->
        <div class="bg-neutral-950/80 backdrop-blur-md p-8 sm:p-10 rounded-3xl border border-neutral-800/80 shadow-2xl relative overflow-hidden">
            <!-- Glow decorativo superior -->
            <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-64 h-32 bg-gold/15 blur-3xl rounded-full pointer-events-none"></div>

            <!-- Encabezado -->
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-neutral-900 border border-neutral-800 text-gold mb-4 shadow-inner">
                    <i class="fa-solid fa-key text-2xl"></i>
                </div>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">¿Olvidaste tu contraseña?</h1>
                <p class="text-neutral-400 text-sm mt-2 max-w-sm mx-auto">
                    Ingresa el correo electrónico asociado a tu cuenta de OilSkin y te generaremos un enlace seguro para restablecerla.
                </p>
            </div>

            <!-- Flash Messages -->
            {% with messages = get_flashed_messages(with_categories=true) %}
                {% if messages %}
                    <div class="mb-6 space-y-3">
                        {% for category, message in messages %}
                            <div class="flex items-start p-4 text-sm rounded-2xl border {% if category == 'success' %}bg-emerald-950/40 text-emerald-300 border-emerald-500/40{% elif category == 'danger' or category == 'error' %}bg-red-950/40 text-red-300 border-red-500/40{% else %}bg-amber-950/40 text-amber-300 border-amber-500/40{% endif %} shadow-lg backdrop-blur-sm" role="alert">
                                <i class="fa-solid {% if category == 'success' %}fa-circle-check text-emerald-400{% elif category == 'danger' or category == 'error' %}fa-circle-exclamation text-red-400{% else %}fa-circle-info text-amber-400{% endif %} mt-0.5 me-3 text-base"></i>
                                <div class="flex-1 font-medium">{{ message }}</div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endwith %}

            <!-- Si se generó el enlace de recuperación, mostrarlo interactivamente -->
            {% if reset_link %}
            <div class="mb-6 p-4 rounded-2xl bg-gold/10 border border-gold/40 text-neutral-200">
                <div class="flex items-center gap-2 mb-2 text-gold font-semibold text-sm">
                    <i class="fa-solid fa-shield-check"></i>
                    <span>Enlace de Recuperación Generado</span>
                </div>
                <p class="text-xs text-neutral-400 mb-3">
                    Usa el siguiente botón directo o copia el enlace seguro (válido por 1 hora):
                </p>
                <div class="flex flex-col sm:flex-row gap-2 items-center">
                    <a href="{{ reset_link }}" class="w-full sm:w-auto flex-1 text-center bg-gold text-neutral-950 hover:bg-gold-light font-bold py-2.5 px-4 rounded-xl text-sm transition duration-200 shadow-md">
                        <i class="fa-solid fa-arrow-up-right-from-square me-1.5"></i> Restablecer Ahora
                    </a>
                    <button type="button" onclick="navigator.clipboard.writeText('{{ reset_link }}'); alert('Enlace copiado al portapapeles');" class="w-full sm:w-auto px-4 py-2.5 rounded-xl border border-neutral-700 bg-neutral-900 text-neutral-300 hover:text-white hover:border-gold/60 text-xs font-semibold transition">
                        <i class="fa-regular fa-copy me-1"></i> Copiar
                    </button>
                </div>
            </div>
            {% endif %}

            <!-- Formulario -->
            <form action="{{ url_for('auth_blueprint.forgot_password') }}" method="post" class="space-y-5">
                {{ form.csrf_token }}

                <div class="space-y-1.5">
                    <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-neutral-300">
                        Correo Electrónico
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-neutral-500">
                            <i class="fa-regular fa-envelope"></i>
                        </div>
                        {{ form.email(
                            class_='w-full h-11 pl-10 pr-4 bg-neutral-900/90 border border-neutral-700/80 rounded-xl text-white placeholder-neutral-500 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition duration-150 text-sm',
                            placeholder='tu-correo@ejemplo.com',
                            autocomplete='email'
                        ) }}
                    </div>
                    {% if form.email.errors %}
                        {% for error in form.email.errors %}
                            <p class="text-red-400 text-xs mt-1 flex items-center gap-1">
                                <i class="fa-solid fa-triangle-exclamation"></i> {{ error }}
                            </p>
                        {% endfor %}
                    {% endif %}
                </div>

                <button type="submit" class="w-full h-11 bg-gold hover:bg-gold-light text-neutral-950 font-bold rounded-xl transition duration-200 shadow-lg shadow-gold/20 flex items-center justify-center gap-2 cursor-pointer text-sm">
                    <span>Enviar Enlace de Recuperación</span>
                    <i class="fa-solid fa-paper-plane text-xs"></i>
                </button>
            </form>

            <!-- Links de retorno -->
            <div class="mt-8 pt-6 border-t border-neutral-800/80 text-center flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-xs text-neutral-400">
                <a href="{{ url_for('auth_blueprint.login') }}" class="text-neutral-300 hover:text-gold transition flex items-center gap-1">
                    <i class="fa-solid fa-arrow-left text-[10px]"></i> Volver a Iniciar Sesión
                </a>
                <span class="hidden sm:inline text-neutral-700">•</span>
                <a href="{{ url_for('auth_blueprint.register') }}" class="text-neutral-300 hover:text-gold transition">
                    ¿No tienes cuenta? <span class="text-gold font-medium">Regístrate</span>
                </a>
            </div>
        </div>

    </div>
</main>
{% endblock %}
