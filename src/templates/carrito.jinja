{% extends 'components/tailwind/layout.jinja' %}
{% block title %}Mi Carrito de Compras - OilSkin Cosmética Natural{% endblock %}

{% block content %}
<main class="min-h-screen py-12" style="background: linear-gradient(rgba(0,0,0,0.85), rgba(0,0,0,0.85)), url('{{ url_for('static', filename='img/fondo_2.png') }}') center/cover no-repeat fixed;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 mb-8 border-b border-neutral-800 gap-4">
            <div>
                <span class="text-gold text-xs font-bold uppercase tracking-widest flex items-center gap-1.5 mb-1">
                    <i class="fa-solid fa-leaf"></i> Cosmética Botánica
                </span>
                <h1 class="text-3xl sm:text-4xl font-extrabold text-white flex items-center gap-3">
                    <span>🛒 Mi Carrito de Compras</span>
                    {% if total_items and total_items > 0 %}
                        <span class="text-xs font-extrabold px-3 py-1 rounded-full bg-gold text-neutral-950 shadow-md align-middle">
                            {{ total_items }} {{ 'producto' if total_items == 1 else 'productos' }}
                        </span>
                    {% endif %}
                </h1>
            </div>
            <a href="{{ url_for('main_blueprint.index') }}" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-neutral-700 bg-neutral-900/80 text-neutral-300 hover:text-gold hover:border-gold transition text-sm font-semibold self-start md:self-auto">
                <i class="fa-solid fa-arrow-left"></i> Continuar comprando
            </a>
        </div>

        <!-- Flash Messages (Flowbite Alert) -->
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                <div class="mb-6 space-y-3">
                    {% for category, message in messages %}
                        <div class="flex items-center p-4 text-sm rounded-2xl border {% if category == 'success' %}bg-emerald-950/40 text-emerald-300 border-emerald-500/40{% elif category == 'danger' or category == 'error' %}bg-red-950/40 text-red-300 border-red-500/40{% else %}bg-amber-950/40 text-amber-300 border-amber-500/40{% endif %} shadow-lg backdrop-blur-sm" role="alert">
                            <i class="fa-solid {% if category == 'success' %}fa-circle-check text-emerald-400{% elif category == 'danger' or category == 'error' %}fa-circle-exclamation text-red-400{% else %}fa-circle-info text-amber-400{% endif %} me-3 text-lg"></i>
                            <div class="flex-1 font-medium">{{ message }}</div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endwith %}

        {% if carrito and carrito|length > 0 %}
            <!-- Shipping Promotion Alert -->
            <div class="p-4 mb-8 rounded-2xl bg-gold/10 border border-gold/30 flex flex-col sm:flex-row items-center justify-between gap-3 text-white">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-gold/20 flex items-center justify-center text-gold shrink-0">
                        <i class="fa-solid fa-truck-bolt"></i>
                    </div>
                    <span class="text-xs sm:text-sm font-medium">¡Tu pedido califica para <strong class="text-gold">Envío Gratis</strong> con seguimiento satelital a todo el país!</span>
                </div>
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 shrink-0">
                    Envío Bonificado
                </span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                
                <!-- Lista de Productos (Left) -->
                <div class="lg:col-span-8 space-y-4">
                    {% for item in carrito %}
                        <div class="bg-neutral-900/90 border border-neutral-800 hover:border-gold/40 rounded-2xl p-5 sm:p-6 shadow-lg transition duration-200 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
                            
                            <!-- Info Item -->
                            <div class="flex items-center gap-4 flex-1 min-w-0">
                                <div class="w-16 h-16 rounded-2xl bg-black border border-gold/30 flex items-center justify-center text-gold shrink-0 shadow-inner">
                                    <i class="fa-solid fa-spray-can-sparkles text-2xl"></i>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <span class="text-[10px] uppercase font-bold tracking-widest text-neutral-400">Ref: #OS-PROD-{{ item.id_producto }}</span>
                                    <h3 class="text-white font-bold text-base truncate mt-0.5">{{ item.nombre_producto }}</h3>
                                    <p class="text-gold font-bold text-sm mt-1">
                                        ${{ "{:,.2f}".format(item.precio_unitario) }} <span class="text-neutral-400 text-xs font-normal">COP c/u</span>
                                    </p>
                                </div>
                            </div>

                            <!-- Controls & Subtotal -->
                            <div class="flex items-center justify-between sm:justify-end gap-6 pt-4 sm:pt-0 border-t sm:border-t-0 border-neutral-800">
                                
                                <!-- Selector Cantidad -->
                                <form action="{{ url_for('main_blueprint.actualizar_carrito') }}" method="post" class="flex items-center">
                                    <input type="hidden" name="producto_id" value="{{ item.id_producto }}">
                                    <div class="flex items-center rounded-xl bg-black border border-neutral-700 overflow-hidden shadow-inner">
                                        <button type="submit" name="cantidad" value="{{ item.cantidad - 1 }}" class="px-3 py-1.5 text-gold hover:bg-neutral-800 transition font-bold text-sm" title="Disminuir">-</button>
                                        <input type="text" readonly class="w-12 text-center bg-transparent text-white border-0 text-xs font-bold focus:ring-0" value="{{ item.cantidad }}">
                                        <button type="submit" name="cantidad" value="{{ item.cantidad + 1 }}" class="px-3 py-1.5 text-gold hover:bg-neutral-800 transition font-bold text-sm" title="Aumentar">+</button>
                                    </div>
                                </form>

                                <!-- Subtotal Línea -->
                                <div class="text-right min-w-[100px]">
                                    <span class="text-[10px] text-neutral-400 uppercase font-medium block">Subtotal</span>
                                    <div class="text-lg font-black text-gold">
                                        ${{ "{:,.2f}".format(item.subtotal) }}
                                    </div>
                                </div>

                                <!-- Eliminar -->
                                <a href="{{ url_for('main_blueprint.eliminar_del_carrito', id_producto=item.id_producto) }}" 
                                   class="w-9 h-9 rounded-xl border border-red-500/30 bg-red-500/10 text-red-400 hover:bg-red-500 hover:text-white transition flex items-center justify-center text-sm shrink-0" 
                                   title="Eliminar del carrito"
                                   onclick="return confirm('¿Deseas retirar este producto de tu carrito?');">
                                    <i class="fa-solid fa-trash-can"></i>
                                </a>
                            </div>

                        </div>
                    {% endfor %}

                    <!-- Trust Guarantee Bar -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4">
                        <div class="p-4 rounded-2xl bg-neutral-900/60 border border-neutral-800 text-center text-xs text-neutral-400">
                            <i class="fa-solid fa-shield-halved text-gold me-1.5 text-sm"></i> Pago Seguro y Cifrado
                        </div>
                        <div class="p-4 rounded-2xl bg-neutral-900/60 border border-neutral-800 text-center text-xs text-neutral-400">
                            <i class="fa-solid fa-seedling text-gold me-1.5 text-sm"></i> 100% Extractos Naturales
                        </div>
                        <div class="p-4 rounded-2xl bg-neutral-900/60 border border-neutral-800 text-center text-xs text-neutral-400">
                            <i class="fa-solid fa-rotate-left text-gold me-1.5 text-sm"></i> Garantía de Satisfacción
                        </div>
                    </div>
                </div>

                <!-- Tarjeta Resumen de Pedido (Right) -->
                <div class="lg:col-span-4">
                    <div class="bg-neutral-900 border border-gold/35 rounded-3xl p-6 shadow-2xl sticky top-24 space-y-6">
                        
                        <div class="flex items-center justify-between pb-4 border-b border-neutral-800">
                            <h2 class="text-lg font-bold text-white flex items-center gap-2">
                                <i class="fa-solid fa-receipt text-gold"></i> Resumen del Pedido
                            </h2>
                        </div>
                        
                        <div class="space-y-3 text-sm">
                            <div class="flex justify-between text-neutral-300">
                                <span>Subtotal de productos:</span>
                                <span class="font-bold text-white">${{ "{:,.2f}".format(total_precio) }}</span>
                            </div>

                            <div class="flex justify-between text-neutral-300">
                                <span>Cantidad de artículos:</span>
                                <span class="font-bold text-white">{{ total_items }} unidades</span>
                            </div>

                            <div class="flex justify-between text-neutral-300">
                                <span>Costo de envío estimado:</span>
                                <span class="text-emerald-400 font-bold flex items-center gap-1"><i class="fa-solid fa-check text-xs"></i> Gratis</span>
                            </div>
                        </div>

                        <div class="pt-4 border-t border-neutral-800">
                            <div class="flex justify-between items-baseline mb-6">
                                <div>
                                    <span class="text-xs uppercase font-extrabold text-neutral-400 block tracking-wider">Total a Pagar:</span>
                                    <span class="text-[10px] text-neutral-400">Impuestos (IVA) incluidos</span>
                                </div>
                                <span class="text-2xl sm:text-3xl font-black text-gold">
                                    ${{ "{:,.2f}".format(total_precio) }}
                                </span>
                            </div>

                            {% if session.get('user_id') %}
                                <a href="{{ url_for('user_blueprint.user_checkout') }}" class="w-full py-4 px-6 rounded-xl font-extrabold text-neutral-950 bg-gold hover:bg-gold-light shadow-xl shadow-gold/20 transition-all transform hover:-translate-y-0.5 flex items-center justify-center gap-2 text-sm">
                                    <span>Proceder al Checkout</span> <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            {% else %}
                                <a href="{{ url_for('main_blueprint.checkout') }}" class="w-full py-4 px-6 rounded-xl font-extrabold text-neutral-950 bg-gold hover:bg-gold-light shadow-xl shadow-gold/20 transition-all transform hover:-translate-y-0.5 flex items-center justify-center gap-2 text-sm mb-3">
                                    <span>Proceder al Checkout</span> <i class="fa-solid fa-arrow-right"></i>
                                </a>
                                <div class="text-center">
                                    <span class="text-xs text-neutral-400">¿Ya tienes cuenta? <a href="{{ url_for('auth_blueprint.login') }}" class="text-gold font-bold hover:underline">Inicia sesión</a></span>
                                </div>
                            {% endif %}
                        </div>

                        <div class="pt-4 border-t border-neutral-800 text-center">
                            <span class="text-xs text-neutral-400 inline-flex items-center gap-2">
                                <i class="fa-solid fa-lock text-gold"></i> Transacción segura con protección SSL
                            </span>
                        </div>
                    </div>
                </div>

            </div>
        {% else %}
            <!-- Empty State -->
            <div class="text-center py-16 px-6 rounded-3xl max-w-xl mx-auto my-8 bg-neutral-900/90 border border-gold/20 shadow-2xl space-y-6">
                <div class="w-24 h-24 mx-auto rounded-full bg-gold/10 border-2 border-gold/30 flex items-center justify-center text-gold">
                    <i class="fa-solid fa-basket-shopping text-4xl"></i>
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-white mb-2">Tu carrito de compras está vacío</h2>
                    <p class="text-neutral-400 text-sm leading-relaxed">
                        Descubre nuestra exclusiva selección de cosméticos botánicos formulados con extractos puros de palma africana y aceites esenciales.
                    </p>
                </div>
                <a href="{{ url_for('main_blueprint.index') }}" class="inline-flex items-center gap-2 px-8 py-3.5 bg-gold hover:bg-gold-light text-neutral-950 font-bold rounded-xl text-sm shadow-lg shadow-gold/20 transition transform hover:-translate-y-0.5">
                    <i class="fa-solid fa-store"></i> Explorar Catálogo
                </a>
            </div>
        {% endif %}

    </div>
</main>
{% endblock %}