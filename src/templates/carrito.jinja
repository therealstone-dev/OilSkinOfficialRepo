{% extends 'components/boostrap/layout_boostrap.jinja' %}
{% block title %}Carrito - OilSkin{% endblock %}
{% block content %}
<div class="container py-5">
    <h1 class="mb-4">Carrito de compras</h1>

    {% if carrito and carrito|length > 0 %}
        <div class="row g-4">
            <div class="col-lg-8">
                {% for item in carrito %}
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="card-title mb-1">{{ item.nombre_producto }}</h5>
                                <p class="text-muted mb-0">Precio unitario: ${{ "%.2f"|format(item.precio_unitario) }}</p>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <form action="{{ url_for('main_blueprint.actualizar_carrito') }}" method="post" class="d-flex align-items-center gap-2">
                                    <input type="hidden" name="producto_id" value="{{ item.id_producto }}">
                                    <input type="number" name="cantidad" value="{{ item.cantidad }}" min="1" class="form-control form-control-sm" style="width: 80px;">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Actualizar</button>
                                </form>
                                <a href="{{ url_for('main_blueprint.eliminar_del_carrito', id_producto=item.id_producto) }}" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h4 class="card-title">Resumen</h4>
                        <p class="mb-2">Artículos: {{ total_items }}</p>
                        <p class="mb-3">Total: ${{ "%.2f"|format(total_precio) }}</p>
                        <a href="{{ url_for('main_blueprint.checkout') }}" class="btn btn-primary w-100">Finalizar compra</a>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info">Tu carrito está vacío.</div>
    {% endif %}
</div>
{% endblock %}