{% extends 'components/tailwind/layout.jinja' %}

{% block title %}Inicio - OilSkin Cosmética Natural{% endblock %}

{% block content %}

<!-- HERO SECTION -->
<header class="relative overflow-hidden py-16 md:py-24 border-b border-neutral-800" style="background: linear-gradient(rgba(0,0,0,0.85), rgba(0,0,0,0.85)), url('{{ url_for('static', filename='img/fondo_2.png') }}') center/cover no-repeat;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row items-center justify-between gap-12 text-center lg:text-left">

            <div class="shrink-0 relative group">
                <div class="absolute -inset-1 bg-gradient-to-r from-gold to-amber-500 rounded-full blur opacity-70 group-hover:opacity-100 transition duration-1000 group-hover:duration-200"></div>
                <img src="{{ url_for('static', filename='img/logo.png') }}"
                     class="relative rounded-full w-40 h-40 md:w-48 md:h-48 object-cover border-4 border-gold shadow-2xl"
                     alt="Logo OilSkin">
            </div>

            <div class="max-w-2xl text-white space-y-6">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-gold/10 border border-gold/30 text-gold text-xs font-bold uppercase tracking-widest">
                    <i class="fa-solid fa-seedling"></i> 100% Extractos Orgánicos de Palma
                </div>
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white">
                    OIL <span class="text-gold">SKIN</span>
                </h1>
                <p class="text-lg md:text-xl text-neutral-300 font-light leading-relaxed">
                    Descubre la riqueza de la cosmética natural enriquecida con extractos puros de palma y aceites esenciales 100% orgánicos. Nutrición profunda, suavidad única y cuidado especializado para tu piel.
                </p>
                <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                    <a href="{{ url_for('main_blueprint.show_category', category_name='Cuidado Corporal') }}"
                       class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 text-sm font-bold text-neutral-950 bg-gold hover:bg-gold-light rounded-xl shadow-lg shadow-gold/20 transition-all duration-200 transform hover:-translate-y-0.5">
                        <i class="fa-solid fa-bag-shopping"></i>
                        <span>¡Explora nuestros productos!</span>
                    </a>
                    <a href="{{ url_for('main_blueprint.about') }}"
                       class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-semibold text-white bg-neutral-900/80 hover:bg-neutral-800 border border-neutral-700 rounded-xl transition">
                        <span>Conoce nuestra historia</span>
                        <i class="fa-solid fa-arrow-right text-xs text-gold"></i>
                    </a>
                </div>
            </div>

        </div>
    </div>
</header>

<main class="py-16 md:py-20" style="background: linear-gradient(rgba(0,0,0,0.88), rgba(0,0,0,0.88)), url('{{ url_for('static', filename='img/palmas.png') }}') center/cover no-repeat fixed;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- BENEFICIOS CLAVE -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-20">

            <div class="bg-neutral-900/80 backdrop-blur-sm border border-neutral-800 hover:border-gold/50 rounded-2xl p-6 text-center transition-all duration-300 hover:shadow-xl hover:shadow-gold/5">
                <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-gold/10 border border-gold/30 flex items-center justify-center text-gold">
                    <i class="fa-solid fa-leaf text-2xl"></i>
                </div>
                <h3 class="text-white text-lg font-bold mb-1">100% Orgánico</h3>
                <p class="text-neutral-400 text-sm">Ingredientes naturales y puros sin químicos agresivos.</p>
            </div>

            <div class="bg-neutral-900/80 backdrop-blur-sm border border-neutral-800 hover:border-gold/50 rounded-2xl p-6 text-center transition-all duration-300 hover:shadow-xl hover:shadow-gold/5">
                <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-gold/10 border border-gold/30 flex items-center justify-center text-gold">
                    <i class="fa-solid fa-droplet text-2xl"></i>
                </div>
                <h3 class="text-white text-lg font-bold mb-1">Nutrición Intensa</h3>
                <p class="text-neutral-400 text-sm">Hidratación y restauración celular profunda todo el día.</p>
            </div>

            <div class="bg-neutral-900/80 backdrop-blur-sm border border-neutral-800 hover:border-gold/50 rounded-2xl p-6 text-center transition-all duration-300 hover:shadow-xl hover:shadow-gold/5">
                <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-gold/10 border border-gold/30 flex items-center justify-center text-gold">
                    <i class="fa-solid fa-star text-2xl"></i>
                </div>
                <h3 class="text-white text-lg font-bold mb-1">Efecto Glow</h3>
                <p class="text-neutral-400 text-sm">Luminosidad botánica natural, piel suave y rejuvenecida.</p>
            </div>

            <div class="bg-neutral-900/80 backdrop-blur-sm border border-neutral-800 hover:border-gold/50 rounded-2xl p-6 text-center transition-all duration-300 hover:shadow-xl hover:shadow-gold/5">
                <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-gold/10 border border-gold/30 flex items-center justify-center text-gold">
                    <i class="fa-solid fa-shield-halved text-2xl"></i>
                </div>
                <h3 class="text-white text-lg font-bold mb-1">Testeado & Seguro</h3>
                <p class="text-neutral-400 text-sm">Fórmulas dermatológicamente probadas para todo tipo de piel.</p>
            </div>

        </div>

        <!-- SECCIÓN DE NUESTRA EMPRESA -->
        <div class="text-center mb-12">
            <span class="text-gold uppercase tracking-widest text-xs font-bold">Compromiso Botánico</span>
            <h2 class="text-3xl md:text-4xl font-extrabold text-white mt-2">
                Nuestra Filosofía y Excelencia
            </h2>
            <div class="w-20 h-1 bg-gold mx-auto mt-4 rounded-full"></div>
        </div>

        <div class="space-y-6 max-w-5xl mx-auto">

            <!-- PILAR 1 -->
            <div class="bg-neutral-900/70 backdrop-blur-md border border-neutral-800 rounded-3xl p-6 md:p-8 flex flex-col md:flex-row items-center gap-8 transition hover:border-neutral-700">
                <div class="shrink-0 text-center">
                    <img src="{{ url_for('static', filename='img/publicidad.jpg') }}"
                         class="rounded-2xl w-32 h-32 md:w-36 md:h-36 object-cover border-2 border-gold/40 shadow-lg mx-auto"
                         alt="Ingredientes Naturales">
                </div>
                <div class="flex-1 text-center md:text-left space-y-2">
                    <span class="text-gold text-xs font-bold uppercase tracking-wider">Pilar 01</span>
                    <h3 class="text-white text-xl font-bold">Ingredientes <span class="text-gold">Naturales y Sostenibles</span></h3>
                    <p class="text-neutral-300 text-base leading-relaxed pl-0 md:pl-4 md:border-l-2 md:border-gold/40">
                        Aceites y extractos <strong class="text-gold font-semibold">100% orgánicos</strong>, libres de parabenos, sulfatos y aditivos agresivos para el cuidado más puro.
                    </p>
                </div>
            </div>

            <!-- PILAR 2 -->
            <div class="bg-neutral-900/70 backdrop-blur-md border border-neutral-800 rounded-3xl p-6 md:p-8 flex flex-col md:flex-row-reverse items-center gap-8 transition hover:border-neutral-700">
                <div class="shrink-0 text-center">
                    <img src="{{ url_for('static', filename='img/publicidad.jpg') }}"
                         class="rounded-2xl w-32 h-32 md:w-36 md:h-36 object-cover border-2 border-gold/40 shadow-lg mx-auto"
                         alt="Cuidado Profundo">
                </div>
                <div class="flex-1 text-center md:text-right space-y-2">
                    <span class="text-gold text-xs font-bold uppercase tracking-wider">Pilar 02</span>
                    <h3 class="text-white text-xl font-bold">Cuidado <span class="text-gold">Profundo y Reparador</span></h3>
                    <p class="text-neutral-300 text-base leading-relaxed pr-0 md:pr-4 md:border-r-2 md:border-gold/40">
                        Fórmulas de <strong class="text-gold font-semibold">nutrición intensiva</strong> que fortalecen la barrera lipídica y protegen tu piel de factores ambientales.
                    </p>
                </div>
            </div>

            <!-- PILAR 3 -->
            <div class="bg-neutral-900/70 backdrop-blur-md border border-neutral-800 rounded-3xl p-6 md:p-8 flex flex-col md:flex-row items-center gap-8 transition hover:border-neutral-700">
                <div class="shrink-0 text-center">
                    <img src="{{ url_for('static', filename='img/publicidad.jpg') }}"
                         class="rounded-2xl w-32 h-32 md:w-36 md:h-36 object-cover border-2 border-gold/40 shadow-lg mx-auto"
                         alt="Resultados Visibles">
                </div>
                <div class="flex-1 text-center md:text-left space-y-2">
                    <span class="text-gold text-xs font-bold uppercase tracking-wider">Pilar 03</span>
                    <h3 class="text-white text-xl font-bold">Resultados <span class="text-gold">Visibles y Comprobados</span></h3>
                    <p class="text-neutral-300 text-base leading-relaxed pl-0 md:pl-4 md:border-l-2 md:border-gold/40">
                        Piel notablemente más suave, firme, luminosa e hidratada desde las primeras semanas de aplicación constante.
                    </p>
                </div>
            </div>

        </div>

    </div>
</main>

{% endblock %}