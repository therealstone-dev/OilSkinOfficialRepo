<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ producto.nombre_producto }} - OilSkin</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

    <div class="container py-5" style="max-width: 700px;">
        <div class="card shadow p-4">

            <h1 class="display-5 fw-bold text-dark mb-3">
                {{ producto.nombre_producto }}
            </h1>

            <p class="fs-5 text-secondary mb-4">
                {{ producto.descripcion }}
            </p>

            <div class="bg-light border-start border-4 border-primary p-3 mb-4">
                <p class="mb-1 fs-5">
                    <strong>Precio:</strong> ${{ producto.precio }}
                </p>
                <p class="mb-0 fs-5">
                    <strong>Stock:</strong> {{ producto.stock }} unidades
                </p>
            </div>

            <form action="{{ url_for('main_blueprint.agregar_al_carrito') }}" method="post" class="mt-4">
                <input type="hidden" name="producto_id" value="{{ producto.id_producto }}">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <label for="cantidad" class="fw-semibold">Cantidad:</label>
                    <input type="number" id="cantidad" name="cantidad" value="1" min="1" class="form-control" style="width: 90px;">
                </div>
                <button type="submit" class="btn btn-success fw-bold">
                    Agregar al carrito
                </button>
            </form>

            <a href="/" class="btn btn-primary fw-bold mt-3">
                ← Volver a productos
            </a>
            <a href="{{ url_for('main_blueprint.carrito') }}" class="btn btn-outline-secondary fw-bold mt-3 ms-2">
                Ir al Carrito
            </a>
        </div>
    </div>

</body>
</html>